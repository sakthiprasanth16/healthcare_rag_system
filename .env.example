# ══════════════════════════════════════════
# Healthcare RAG System — Environment Config
# ══════════════════════════════════════════
# Copy this file to .env and fill in your keys

# Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_THE_API_HERE

# Pinecone API Key
# Get it from: https://app.pinecone.io
PINECONE_API_KEY=PASTE_THE_API_HERE

# Pinecone Index Name (must be 768 dimensions, cosine metric)
PINECONE_INDEX_NAME=healthcare-rag

# MongoDB Connection URI
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=PASTE_THE_URI_HERE
# MongoDB Database Name
MONGO_DB_NAME=healthcare_rag

# LLM Model (optional — defaults to gemini-2.5-flash-lite)
LLM_MODEL=gemini-2.5-flash-lite

# Backend URL (used by Streamlit frontend)
BACKEND_URL=http://localhost:8000
